generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id              String         @id @default(cuid())
  email           String         @unique
  password        String
  name            String?
  phone           String?
  apiKey          String?
  apiKeyConnected Boolean        @default(false)
  
  // === TEAM / SUB-USERS ===
  role            String         @default("admin")   // admin, manager, agent, support, viewer
  parentUserId    String?                             // null = dueño principal, con valor = sub-usuario
  permissions     Json           @default("{\"dashboard\":true,\"conversations\":true,\"crm\":true,\"agenda\":true,\"assistants\":true,\"whatsapp\":true,\"config\":true,\"team\":true,\"products\":true}")
  invitedBy       String?
  isActive        Boolean        @default(true)
  
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  assistants      Assistant[]
  conversations   Conversation[]
  products        Product[]
  clients         Client[]
  appointments    Appointment[]

  @@index([parentUserId])
  @@index([role])
}

model Assistant {
  id              String    @id @default(cuid())
  userId          String
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  name            String
  context         String?   @db.Text
  personality     String?   @db.Text
  businessInfo    String?   @db.Text
  instructions    String?   @db.Text
  
  knowledgeItems  Json      @default("[]")
  mediaItems      Json      @default("[]")
  
  elevenLabsKey   String?
  selectedVoice   String?
  voiceEnabled    Boolean   @default(false)
  
  autoLearn       Boolean   @default(true)
  learningHistory Json      @default("[]")
  
  model           String    @default("gpt-4-turbo-preview")
  temperature     Float     @default(0.7)
  maxTokens       Int       @default(500)
  
  isActive        Boolean   @default(false)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([userId])
}

model Conversation {
  id            String    @id @default(cuid())
  recipientId   String
  recipientName String?
  lastMessage   String?
  aiPaused      Boolean   @default(false)
  stage         String    @default("new")
  assignedTo    String?                      // userId del vendedor/soporte asignado
  assignedName  String?                      // Nombre visible del asignado
  contextData   Json?                        // 🧠 Memoria persistente: nombre, talla, color, etc.
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages      Message[]

  @@index([recipientId])
  @@index([userId, stage])
  @@index([assignedTo])
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  content        String       @db.Text
  fromMe         Boolean      @default(false)
  timestamp      DateTime     @default(now())
  mediaType      String?
  mediaUrl       String?      @db.Text
  userId         String?
  role           String       @default("user")
}

model Product {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  description String?  @db.Text
  price       Float
  category    String?
  image       String?  @db.Text
  stock       Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId])
}

model Client {
  id             String        @id @default(cuid())
  userId         String
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  name           String
  phone          String
  email          String?
  address        String?       @db.Text
  notes          String?       @db.Text
  tags           String[]      @default([])
  status         String        @default("lead")
  totalPurchases Float         @default(0)
  lastContact    DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  appointments   Appointment[]

  @@index([userId])
}

model Appointment {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  clientId    String?
  client      Client?  @relation(fields: [clientId], references: [id], onDelete: SetNull)
  
  type        String
  clientName  String
  clientPhone String
  date        DateTime
  time        String
  duration    Int?
  status      String   @default("pending")
  notes       String?  @db.Text
  address     String?  @db.Text
  products    Json?
  total       Float?
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId, date])
}
