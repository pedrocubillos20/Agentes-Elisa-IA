# Base de datos (Supabase)
DATABASE_URL=postgresql://postgres.xxx:[PASSWORD]@aws-0-sa-east-1.pooler.supabase.com:6543/postgres

# JWT
JWT_SECRET=tu-clave-secreta-muy-larga-de-32-caracteres
JWT_EXPIRES_IN=7d

# Encriptación de API Keys
ENCRYPTION_KEY=clave-de-32-caracteres-exactos!!

# Wompi (Pagos Colombia)
WOMPI_PUBLIC_KEY=pub_prod_xxxxxxxxxxxxx
WOMPI_PRIVATE_KEY=prv_prod_xxxxxxxxxxxxx
WOMPI_EVENT_SECRET=prod_event_xxxxxxxxxxxxx
WOMPI_INTEGRITY_SECRET=prod_integrity_xxxxxxxxxxxxx

# URLs
