# ================================================================
# BIUZONNE BACKEND — Variables de Entorno
# ================================================================
# INSTRUCCIONES:
# 1. Copia este archivo: cp .env.example .env
# 2. Rellena TODOS los campos marcados como OBLIGATORIO
# 3. NUNCA subas .env a Git
# ================================================================

# ===== BASE DE DATOS (OBLIGATORIO) =====
DATABASE_URL="postgresql://user:password@host:5432/bizonne?schema=public"
DIRECT_URL="postgresql://user:password@host:5432/bizonne?schema=public"
# Para Supabase con pooler (puerto 6543):
# DATABASE_URL="postgresql://postgres.xxx:password@aws-0-us-east-1.pooler.supabase.com:6543/postgres"
# DIRECT_URL="postgresql://postgres.xxx:password@aws-0-us-east-1.pooler.supabase.com:5432/postgres"

# ===== AUTENTICACIÓN (OBLIGATORIO) =====
JWT_SECRET="CAMBIAR-esto-por-un-secreto-aleatorio-de-64-caracteres-minimo"
REFRESH_SECRET="CAMBIAR-otro-secreto-diferente-para-refresh-tokens-64-chars"
# Generar con: openssl rand -hex 64

# ===== SERVIDOR =====
PORT=3000
NODE_ENV=development
# En producción:
# NODE_ENV=production

# ===== CORS / URLS =====
FRONTEND_URL=http://localhost:3001
BACKEND_URL=http://localhost:3000
# En producción:
# FRONTEND_URL=https://app.bizonne.com
# BACKEND_URL=https://api.bizonne.com

# ===== EMAIL (OBLIGATORIO para recuperación contraseña) =====
RESEND_API_KEY=re_xxxxxxxxxxxx

# ===== WHATSAPP (OBLIGATORIO) =====
WAHA_API_URL=http://localhost:8080
WAHA_API_KEY=tu-waha-api-key

# ===== OPENAI (OBLIGATORIO para IA) =====
OPENAI_API_KEY=sk-xxxxxxxxxxxx

# ===== STORAGE (Cloudflare R2 o local) =====
# Si no se configura R2, guarda en LOCAL_MEDIA_DIR
R2_ACCOUNT_ID=
R2_ACCESS_KEY=
R2_SECRET_KEY=
R2_BUCKET_NAME=bizonne-media
R2_PUBLIC_URL=

# Directorio local (fallback si no hay R2)
LOCAL_MEDIA_DIR=/home/claude/media

# ===== PAGOS WOMPI =====
WOMPI_PUBLIC_KEY=
WOMPI_PRIVATE_KEY=
WOMPI_EVENTS_SECRET=
WOMPI_INTEGRITY_KEY=

# ===== GOOGLE CALENDAR =====
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://api.bizonne.com/api/gcal/callback

# ===== RETELL AI (Llamadas) =====
RETELL_API_KEY=

# ===== ELEVEN LABS (Voz) =====
ELEVENLABS_API_KEY=

# ===== ADMIN =====
ADMIN_SECRET_KEY=

# ===== LOGS =====
LOG_LEVEL=info
# En desarrollo: debug
# En producción: info
LOGS_DIR=./logs
