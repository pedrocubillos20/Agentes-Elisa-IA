generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x", "debian-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Plan {
  FREE
  EMPRENDEDORES
  NEGOCIOS
  BUSINESS
  MARCA_BLANCA
}

enum PlanType {
  MONTHLY
  LIFETIME
}

enum SubscriptionStatus {
  ACTIVE
  INACTIVE
  PAST_DUE
  CANCELED
}

enum AssistantTone {
  PROFESSIONAL
  FRIENDLY
  CASUAL
}

enum AssistantStatus {
  ACTIVE
  INACTIVE
  PENDING
}

enum Channel {
  WEB
  WHATSAPP
}

enum ConversationStatus {
  ACTIVE
  RESOLVED
  ESCALATED
  ABANDONED
}

enum MessageRole {
  USER
  ASSISTANT
}

model User {
  id                 String             @id @default(uuid())
  email              String             @unique
  password           String
  firstName          String?
  lastName           String?
  phone              String?
  plan               Plan               @default(FREE)
  planType           PlanType           @default(MONTHLY)
  subscriptionStatus SubscriptionStatus @default(INACTIVE)
  trialEndsAt        DateTime?
  openaiApiKey       String?
  apiKeyConnected    Boolean            @default(false)
  whatsappConnected      Boolean            @default(false)
  whatsappPhone          String?
  whatsappAccessToken    String?            @db.Text
  whatsappPhoneNumberId  String?
  isAdmin                Boolean            @default(false)
  lastLogin          DateTime?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  
  // Marca Blanca
  customLogo         String?
  customBrandName    String?
  referralCode       String?            @unique
  referredBy         String?
  
  businesses Business[]
  assistants Assistant[]
  payments   Payment[]
  configRequests ConfigRequest[]
}

model Business {
  id              String   @id @default(uuid())
  userId          String
  name            String
  industry        String?
  description     String?
  logo            String?
  contactEmail    String?
  contactPhone    String?
  address         String?
  businessHours   String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  products   Product[]
  faqs       FAQ[]
  assistants Assistant[]
}

model Product {
  id          String   @id @default(uuid())
  businessId  String
  name        String
  price       Decimal?
  description String?
  features    String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
}

model FAQ {
  id         String   @id @default(uuid())
  businessId String
  question   String
  answer     String
  category   String?
  order      Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
}

model Assistant {
  id             String          @id @default(uuid())
  userId         String
  businessId     String
  name           String
  welcomeMessage String          @default("¡Hola! ¿En qué puedo ayudarte?")
  tone           AssistantTone   @default(PROFESSIONAL)
  systemPrompt   String?
  contextJson    String?         @db.Text
  primaryColor   String          @default("#6366f1")
  publicApiKey   String          @unique
  status         AssistantStatus @default(INACTIVE)
  isActive       Boolean         @default(false)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  business      Business       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  conversations Conversation[]
}

model Conversation {
  id            String             @id @default(uuid())
  assistantId   String
  clientId      String?
  clientName    String?
  clientEmail   String?
  clientPhone   String?
  channel       Channel            @default(WEB)
  status        ConversationStatus @default(ACTIVE)
  messageCount  Int                @default(0)
  lastMessageAt DateTime?
  isLead        Boolean            @default(false)
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  assistant Assistant @relation(fields: [assistantId], references: [id], onDelete: Cascade)
  messages  Message[]
}

model Message {
  id             String      @id @default(uuid())
  conversationId String
  role           MessageRole
  content        String
  tokensUsed     Int?
  responseTime   Int?
  createdAt      DateTime    @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
}

model Payment {
  id            String   @id @default(uuid())
  userId        String
  reference     String   @unique
  plan          String
  amount        Int
  currency      String   @default("COP")
  status        String   @default("PENDING")
  wompiId       String?
  paymentMethod String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model WebhookLog {
  id        String   @id @default(uuid())
  source    String
  event     String
  payload   Json?
  status    String   @default("received")
  error     String?
  createdAt DateTime @default(now())
}

// Solicitudes de configuración (para planes Emprendedores y Negocios)
model ConfigRequest {
  id           String   @id @default(uuid())
  userId       String
  assistantId  String?
  businessName String
  pdfUrl       String?
  pdfFileName  String?
  notes        String?
  status       String   @default("PENDING") // PENDING, IN_PROGRESS, COMPLETED
  adminNotes   String?
  configJson   String?  @db.Text
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}
