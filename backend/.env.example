# Base de datos
DATABASE_URL="postgresql://usuario:password@host:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://usuario:password@host:5432/postgres"

# Autenticación
JWT_SECRET="tu-clave-jwt-secreta-muy-larga-y-segura"
JWT_EXPIRES_IN="30d"

# Encriptación
ENCRYPTION_KEY="tu-clave-encriptacion-32-caracteres"

# Frontend
FRONTEND_URL="https://tu-frontend.vercel.app"

# Servidor
PORT=3001
NODE_ENV=production

# WhatsApp
AUTH_DIR=/app/auth_sessions

# Pagos (Wompi - opcional)
WOMPI_PUBLIC_KEY=""
WOMPI_PRIVATE_KEY=""
WOMPI_EVENT_SECRET=""
WOMPI_ENVIRONMENT="sandbox"
