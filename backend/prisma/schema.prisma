generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id              String         @id @default(cuid())
  email           String         @unique
  password        String
  name            String?
  phone           String?
  apiKey          String?
  apiKeyConnected Boolean        @default(false)
  
  // === TEAM / SUB-USERS ===
  role            String         @default("admin")   // admin, manager, agent, support, viewer
  parentUserId    String?                             // null = dueño principal, con valor = sub-usuario
  permissions     Json           @default("{\"dashboard\":true,\"conversations\":true,\"crm\":true,\"agenda\":true,\"assistants\":true,\"whatsapp\":true,\"config\":true,\"team\":true,\"products\":true}")
  invitedBy       String?
  isActive        Boolean        @default(true)
  
  // === SUBSCRIPTION ===
  plan            String         @default("trial")    // trial, starter, business
  trialEndsAt     DateTime?                            // Fecha fin trial (20 días desde registro)
  subscriptionId  String?                              // ID suscripción activa
  
  // === CUSTOM STAGES ===
  customStages    Json           @default("[]")        // Etapas personalizables del embudo
  
  // === PASSWORD RESET ===
  resetCode       String?                              // Código de 6 dígitos
  resetCodeExpires DateTime?                           // Expira en 15 minutos
  
  // === GOOGLE CALENDAR ===
  googleAccessToken   String?   @db.Text
  googleRefreshToken  String?   @db.Text
  googleTokenExpiry   DateTime?
  googleCalendarId    String?
  googleCalendarEmail String?
  
  // === LEGACY COLUMNS (exist in DB) ===
  apiKeyEncrypted       String?
  evolutionInstanceKey  String?
  evolutionInstanceName String?
  referralCode          String?
  whatsappConnected     Boolean   @default(false)
  whatsappStatus        String?
  
  // === STORAGE ===
  profilePic      String?   @db.Text              // Foto de perfil (base64)
  timezone        String    @default("America/Bogota") // Zona horaria
  storageUsed     Int      @default(0)         // Bytes usados actualmente
  storageLimit    Int      @default(262144000)  // 250MB en bytes (default)
  extraStorage    Int      @default(0)          // Storage adicional comprado (bytes)
  
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  assistants      Assistant[]
  conversations   Conversation[]
  products        Product[]
  clients         Client[]
  appointments    Appointment[]
  subscription    Subscription?
  payments        Payment[]
  whatsappLines   WhatsappLine[]
  apiKeys         UserApiKey[]
  webhooks        UserWebhook[]
  mediaFiles      MediaFile[]
  pushSubscriptions PushSubscription[]
  resources       Resource[]
  businessSchedules BusinessSchedule[]
  ghlIntegration  GhlIntegration?
  callConfig      CallConfig?       // 📞 Retell AI
  calls           Call[]            // 📞 Retell AI

  @@index([parentUserId])
  @@index([role])
}

model Assistant {
  id              String    @id @default(cuid())
  userId          String
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  name            String
  context         String?   @db.Text
  personality     String?   @db.Text
  businessInfo    String?   @db.Text
  instructions    String?   @db.Text
  
  knowledgeItems  Json      @default("[]")
  mediaItems      Json      @default("[]")
  
  elevenLabsKey   String?
  selectedVoice   String?
  voiceEnabled    Boolean   @default(false)
  
  autoLearn       Boolean   @default(true)
  learningHistory Json      @default("[]")
  
  model           String    @default("gpt-4-turbo-preview")
  temperature     Float     @default(0.7)
  maxTokens       Int       @default(500)
  
  whatsappLineId  String?
  isActive        Boolean   @default(false)
  
  // 📍 COBERTURA DE DOMICILIO (opcional — solo si el negocio tiene servicio a domicilio)
  coverageLat     Float?    // Latitud del negocio (ej: 4.6189)
  coverageLon     Float?    // Longitud del negocio (ej: -74.1289)
  coverageRadiusKm Float?   // Radio de cobertura en km (ej: 3.0)
  
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([userId])
  @@index([whatsappLineId])
}

model Conversation {
  id              String    @id @default(cuid())
  recipientId     String
  recipientName   String?
  lastMessage     String?
  aiPaused        Boolean   @default(false)
  stage           String    @default("new")
  assignedTo      String?                      // userId del vendedor/soporte asignado
  assignedName    String?                      // Nombre visible del asignado
  contextData     Json?                        // 🧠 Memoria persistente: nombre, talla, color, etc.
  whatsappLineId  String?                      // 🏗️ Workspace: línea de WhatsApp
  
  // 👥 GRUPOS
  isGroup         Boolean   @default(false)
  isActive        Boolean   @default(true)
  groupName       String?
  groupSettings   Json?     @default("{\"aiEnabled\":true,\"respondTo\":\"all\",\"triggerWords\":[]}")
  
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  userId          String
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages        Message[]

  @@index([recipientId])
  @@index([userId, stage])
  @@index([assignedTo])
  @@index([whatsappLineId])
  @@index([isGroup])
}

model Message {
  id                String       @id @default(cuid())
  conversationId    String
  conversation      Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  content           String       @db.Text
  fromMe            Boolean      @default(false)
  timestamp         DateTime     @default(now())
  mediaType         String?
  mediaUrl          String?      @db.Text
  userId            String?
  role              String       @default("user")
  wamid             String?      // WhatsApp Message ID — para lookup de quoted messages

  @@index([conversationId, timestamp])
  @@index([wamid])
  @@index([conversationId])
  @@index([timestamp])
}

model Product {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name            String
  description     String?  @db.Text
  price           Float
  category        String?
  image           String?  @db.Text
  stock           Int      @default(0)
  isActive        Boolean  @default(true)
  whatsappLineId  String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([userId])
  @@index([whatsappLineId])
}

model Client {
  id              String        @id @default(cuid())
  userId          String
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  name            String
  phone           String
  email           String?
  address         String?       @db.Text
  notes           String?       @db.Text
  tags            String[]      @default([])
  status          String        @default("lead")
  totalPurchases  Float         @default(0)
  lastContact     DateTime?
  whatsappLineId  String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  appointments    Appointment[]

  @@index([userId])
  @@index([whatsappLineId])
}

model Appointment {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  clientId        String?
  client          Client?  @relation(fields: [clientId], references: [id], onDelete: SetNull)
  
  type            String
  clientName      String
  clientPhone     String
  date            DateTime
  time            String
  duration        Int?
  status          String   @default("pending")
  notes           String?  @db.Text
  address         String?  @db.Text
  products        Json?
  total           Float?
  whatsappLineId  String?
  googleEventId   String?
  resourceId      String?
  resourceName    String?
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([userId, date])
  @@index([whatsappLineId])
}

model Subscription {
  id            String    @id @default(cuid())
  userId        String    @unique
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  plan          String                          // starter, business
  period        String    @default("monthly")   // monthly, semiannual, annual
  status        String    @default("active")    // active, cancelled, expired, past_due
  
  priceUsd      Float                           // Precio en USD
  priceCop      Float                           // Precio en COP (al momento del pago)
  
  currentPeriodStart  DateTime
  currentPeriodEnd    DateTime
  cancelledAt         DateTime?
  
  wompiSubscriptionId String?                   // ID de suscripción en Wompi
  wompiTransactionId  String?                   // Último transaction ID
  
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([status])
}

model Payment {
  id              String    @id @default(cuid())
  userId          String
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  type            String                          // subscription, upgrade, renewal
  plan            String                          // starter, business
  period          String                          // monthly, semiannual, annual
  
  amountUsd       Float                           // Monto en USD
  amountCop       Float                           // Monto en COP
  exchangeRate    Float                           // Tasa USD→COP usada
  cardSurcharge   Float    @default(0)            // Recargo 5% tarjeta
  totalCop        Float                           // Total final en COP
  
  // === DESCUENTO APLICADO ===
  discountCode    String?                         // Código usado
  discountPercent Float?                          // % descuento aplicado
  discountAmount  Float?                          // Monto COP descontado
  originalCop     Float?                          // Precio original sin descuento
  
  status          String   @default("pending")    // pending, approved, declined, voided, error
  method          String?                         // CARD, NEQUI, PSE, BANCOLOMBIA_TRANSFER
  
  wompiTransactionId  String?   @unique
  wompiReference      String?
  wompiPaymentMethod  String?
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([userId])
  @@index([status])
  @@index([wompiTransactionId])
}

// ===== CÓDIGOS DE DESCUENTO =====
model DiscountCode {
  id              String    @id @default(cuid())
  
  code            String    @unique               // Código único (ej: BIENVENIDO20, PROMO50)
  description     String?                         // Descripción interna
  
  discountType    String    @default("percent")   // percent, fixed_usd, fixed_cop
  discountValue   Float                           // Valor: 20 = 20% ó $20 USD ó $50000 COP
  
  // === RESTRICCIONES ===
  applicablePlans String[]  @default([])          // [] = todos, ["starter"], ["business"], ["starter","business"]
  applicablePeriods String[] @default([])         // [] = todos, ["monthly"], ["annual"], etc.
  minAmountUsd    Float?                          // Monto mínimo USD para aplicar
  
  // === LÍMITES ===
  maxUses         Int?                            // null = ilimitado
  maxUsesPerUser  Int       @default(1)           // Máximo usos por usuario
  currentUses     Int       @default(0)           // Usos actuales
  
  // === VIGENCIA ===
  startsAt        DateTime  @default(now())       // Fecha inicio
  expiresAt       DateTime?                       // null = no expira
  
  isActive        Boolean   @default(true)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  usages          DiscountUsage[]

  @@index([code])
  @@index([isActive])
}

// === REGISTRO DE USO DE CÓDIGOS ===
model DiscountUsage {
  id              String       @id @default(cuid())
  discountCodeId  String
  discountCode    DiscountCode @relation(fields: [discountCodeId], references: [id], onDelete: Cascade)
  userId          String
  paymentId       String?
  
  amountSaved     Float                           // Monto ahorrado en COP
  
  createdAt       DateTime     @default(now())

  @@index([discountCodeId])
  @@index([userId])
  @@unique([discountCodeId, userId, paymentId])
}

// ===== MULTI-LÍNEA WHATSAPP =====

// ===== MENSAJES PROGRAMADOS =====
model ScheduledMessage {
  id              String    @id @default(cuid())
  userId          String
  whatsappLineId  String?
  
  targetType      String    @default("contact")  // contact, group, stage
  targetId        String                          // phone, group JID, stage name
  targetName      String?
  
  message         String?   @db.Text
  mediaUrl        String?   @db.Text
  mediaType       String?
  
  scheduledAt     DateTime
  recurrence      String    @default("once")      // once, daily, weekly, monthly
  recurrenceDays  Json?                            // [1,3,5] for Mon/Wed/Fri
  recurrenceTime  String?                          // "09:00"
  recurrenceEnd   DateTime?
  timezone        String    @default("America/Bogota")
  
  status          String    @default("pending")    // pending, sent, failed, cancelled
  sentAt          DateTime?
  lastSentAt      DateTime?
  sendCount       Int       @default(0)
  error           String?
  
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([userId])
  @@index([status, scheduledAt])
  @@index([whatsappLineId])
}

model WhatsappLine {
  id              String    @id @default(cuid())
  userId          String
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  label           String    @default("Principal")
  phone           String?
  sessionName     String    @unique
  status          String    @default("disconnected")
  
  // 🔌 Connection type: 'waha' (QR scan) or 'cloud_api' (Meta WhatsApp Cloud API)
  connectionType  String    @default("waha")
  
  // ☁️ WhatsApp Cloud API fields
  cloudPhoneNumberId    String?
  cloudBusinessId       String?
  cloudAccessToken      String?
  cloudWebhookVerifyToken String?
  cloudAppId            String?
  
  assignedTo      String?
  assignedName    String?
  assistantId     String?
  
  // 🔧 Etapas del pipeline por línea (se auto-generan desde base de conocimiento)
  customStages    Json      @default("[]")
  stagesConfigured Boolean  @default(false)
  
  isDefault       Boolean   @default(false)
  isActive        Boolean   @default(true)
  
  resources         Resource[]
  businessSchedules BusinessSchedule[]
  
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([userId])
  @@index([cloudPhoneNumberId])
}

// ====================================================
// 🔌 API & INTEGRATIONS
// ====================================================

model UserApiKey {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String    @default("default")
  key         String    @unique              // Hashed API key
  prefix      String                         // Primeros chars visibles: bz_xxxx...
  isActive    Boolean   @default(true)
  lastUsedAt  DateTime?
  totalCalls  Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([userId])
}

model UserWebhook {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  url         String
  secret      String?                        // HMAC SHA256 signing secret
  events      String[]  @default([])         // Eventos suscritos
  isActive    Boolean   @default(true)
  lastStatus  Int?                           // Último HTTP status
  lastError   String?
  totalSent   Int       @default(0)
  totalFailed Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  
  logs        WebhookLog[]

  @@index([userId])
  @@index([userId, isActive])
}

model WebhookLog {
  id          String    @id @default(cuid())
  webhookId   String
  webhook     UserWebhook @relation(fields: [webhookId], references: [id], onDelete: Cascade)
  userId      String
  event       String
  payload     Json?
  statusCode  Int?
  response    String?
  duration    Int?                           // ms
  success     Boolean   @default(false)
  createdAt   DateTime  @default(now())

  @@index([webhookId])
  @@index([userId, createdAt(sort: Desc)])
}

// ====================================================
// 📁 MEDIA FILE — Tracking de archivos en storage externo
// ====================================================
model MediaFile {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  url         String    // URL pública (R2 o local)
  key         String    // Key en R2 o path local (para eliminar)
  fileName    String
  fileSize    Int       // Bytes
  mimeType    String
  category    String    @default("assistant") // assistant, scheduled, chat
  createdAt   DateTime  @default(now())

  @@index([userId])
  @@index([userId, category])
}

// ====================================================
// 🔗 GOHIGHLEVEL INTEGRATION
// ====================================================

model GhlIntegration {
  id              String    @id @default(cuid())
  userId          String    @unique
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  // Auth — supports BOTH methods
  authMethod      String    @default("apikey")   // "apikey" or "oauth"
  ghlApiKey       String?   @db.Text             // User's own GHL API Key
  accessToken     String?   @db.Text             // OAuth access token
  refreshToken    String?   @db.Text             // OAuth refresh token
  tokenExpiresAt  DateTime?
  
  // GHL Location info
  locationId      String
  locationName    String?
  companyId       String?
  
  // Sync settings
  syncContacts      Boolean   @default(true)
  syncPipeline      Boolean   @default(true)
  syncCalendar      Boolean   @default(true)
  syncConversations Boolean   @default(true)
  syncDirection     String    @default("bidirectional")
  
  // GHL Pipeline mapping
  pipelineId      String?
  pipelineStages  Json      @default("{}")
  calendarId      String?
  
  // Status
  isActive        Boolean   @default(true)
  lastSyncAt      DateTime?
  lastError       String?
  totalSynced     Int       @default(0)
  
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  syncLogs        GhlSyncLog[]

  @@index([userId])
  @@index([locationId])
}

model GhlSyncLog {
  id              String    @id @default(cuid())
  integrationId   String
  integration     GhlIntegration @relation(fields: [integrationId], references: [id], onDelete: Cascade)
  userId          String
  
  action          String
  direction       String
  entityType      String
  bizonneid       String?
  ghlId           String?
  payload         Json?
  success         Boolean   @default(true)
  error           String?
  
  createdAt       DateTime  @default(now())

  @@index([integrationId])
  @@index([userId, createdAt(sort: Desc)])
}

// ===== COMPRAS / PAGOS WOMPI =====
model Purchase {
  id                String    @id @default(cuid())
  reference         String    @unique              // Referencia única BIZ-xxxx
  plan              String                         // starter, business
  period            String                         // monthly, semiannual, annual
  amountCents       Int                            // Monto en centavos COP
  currency          String    @default("COP")
  
  buyerEmail        String?                        // Email del comprador
  buyerName         String?
  
  status            String    @default("pending")  // pending, approved, declined, voided, error
  wompiTransactionId String?                       // ID transacción Wompi
  wompiStatus       String?                        // Estado Wompi raw
  paymentMethod     String?                        // CARD, PSE, NEQUI, etc.
  
  registrationToken String?   @unique              // Token para registrarse
  tokenUsed         Boolean   @default(false)      // Ya se usó el token?
  userId            String?                        // Usuario creado (después de registro)
  
  expiresAt         DateTime?                      // Expiración del token
  paidAt            DateTime?                      // Fecha de pago aprobado
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([reference])
  @@index([registrationToken])
  @@index([buyerEmail])
  @@index([status])
}

// 🔔 Push Notification Subscriptions
model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @db.Text
  keys      Json
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, endpoint])
  @@index([userId])
}

model Resource {
  id              String        @id @default(cuid())
  userId          String
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  name            String
  type            String        @default("generic")
  capacity        Int           @default(1)
  isActive        Boolean       @default(true)
  order           Int           @default(0)
  notes           String?
  whatsappLineId  String?
  whatsappLine    WhatsappLine? @relation(fields: [whatsappLineId], references: [id], onDelete: SetNull)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([userId])
  @@index([whatsappLineId])
}

model BusinessSchedule {
  id              String        @id @default(cuid())
  userId          String
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  dayOfWeek       Int
  isOpen          Boolean       @default(true)
  startTime       String        @default("08:00")
  endTime         String        @default("18:00")
  slotDuration    Int           @default(60)
  breakStart      String?
  breakEnd        String?
  whatsappLineId  String?
  whatsappLine    WhatsappLine? @relation(fields: [whatsappLineId], references: [id], onDelete: SetNull)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@unique([userId, dayOfWeek, whatsappLineId])
  @@index([userId])
}

// ====================================================
// 📞 RETELL AI — Configuración y Historial de Llamadas
// ====================================================

model CallConfig {
  id                  String    @id @default(cuid())
  userId              String    @unique
  user                User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  // Retell AI IDs
  retellAgentId       String?
  retellLlmId         String?
  retellPhoneNumber   String?
  retellPhoneNumberId String?
  
  // Voice settings
  voiceId             String    @default("11labs-Adrian")
  voiceProvider       String    @default("elevenlabs")
  voiceModel          String    @default("eleven_turbo_v2")
  voiceSpeed          Float     @default(1.0)
  voiceTemperature    Float     @default(1.0)
  
  // Agent settings
  agentName           String    @default("Asistente")
  agentLanguage       String    @default("es")
  agentGreeting       String?
  agentPrompt         String?
  
  // Features
  enableAutoReminders Boolean   @default(false)
  reminderHoursBefore Int       @default(24)
  maxCallDuration     Int       @default(300000)
  enableBackchannel   Boolean   @default(true)
  
  // Status
  isActive            Boolean   @default(false)
  activatedAt         DateTime?
  minutesUsed         Float     @default(0)
  minutesLimit        Float     @default(0)
  
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  
  calls               Call[]

  @@index([userId])
}

model Call {
  id                String    @id @default(cuid())
  userId            String
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  callConfigId      String
  callConfig        CallConfig @relation(fields: [callConfigId], references: [id], onDelete: Cascade)
  
  // Retell
  retellCallId      String?
  retellCallStatus  String?
  
  // Call info
  direction         String    @default("outbound")
  fromNumber        String?
  toNumber          String
  toName            String?
  clientId          String?
  appointmentId     String?
  
  // Results
  status            String    @default("initiated")
  duration          Int?
  costUsd           Float?
  transcript        String?   @db.Text
  transcriptObject  Json?
  summary           String?   @db.Text
  sentiment         String?
  recordingUrl      String?
  
  // Meta
  callType          String    @default("manual")
  metadata          Json?
  endReason         String?
  
  startedAt         DateTime?
  endedAt           DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([userId])
  @@index([callConfigId])
  @@index([retellCallId])
  @@index([clientId])
  @@index([status])
  @@index([createdAt])
}
