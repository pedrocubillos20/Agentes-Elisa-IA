# ==========================================
# ELISA IA - CONFIGURACIÓN DE ENTORNO
# ==========================================
# Copia este archivo como .env y completa los valores

# ----- GENERAL -----
NODE_ENV=development
PORT=3001
FRONTEND_URL=http://localhost:3000

# ----- BASE DE DATOS (SUPABASE) -----
# Obtener en: Supabase → Settings → Database → Connection string → URI
DATABASE_URL="postgresql://postgres:TU_PASSWORD@db.xxxxxxxxxxxx.supabase.co:5432/postgres"

# ----- AUTENTICACIÓN -----
# Genera en: https://randomkeygen.com (CodeIgniter Encryption Keys)
JWT_SECRET=tu_jwt_secret_muy_seguro_de_64_caracteres_minimo_aqui
JWT_EXPIRES_IN=7d

# ----- ENCRIPTACIÓN DE API KEYS -----
# Genera con: openssl rand -hex 16 (o 32 caracteres aleatorios)
ENCRYPTION_KEY=tu_clave_de_encriptacion_32_chars

# ----- WOMPI (PAGOS COLOMBIA) -----
# Obtener en: comercios.wompi.co → Desarrolladores
# Usa las llaves de TEST mientras desarrollas
WOMPI_PUBLIC_KEY=pub_test_xxxxxxxxxxxxxxxx
WOMPI_PRIVATE_KEY=prv_test_xxxxxxxxxxxxxxxx
WOMPI_EVENT_SECRET=test_event_xxxxxxxxxxxxxxxx
WOMPI_INTEGRITY_KEY=test_integrity_xxxxxxxxxxxxxxxx
# Cambiar a 'production' cuando vayas a producción
WOMPI_ENVIRONMENT=test

# ----- WHATSAPP BUSINESS API (OPCIONAL) -----
# Configurar en Meta Business Suite
WHATSAPP_TOKEN=tu_token_de_whatsapp
WHATSAPP_PHONE_NUMBER_ID=tu_phone_number_id
WHATSAPP_VERIFY_TOKEN=tu_token_de_verificacion
WHATSAPP_BUSINESS_ACCOUNT_ID=tu_business_account_id

# ----- EMAIL (OPCIONAL) -----
# Puedes usar Resend, SendGrid, etc.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxx
EMAIL_FROM=noreply@tudominio.com

# ----- LOGS -----
LOG_LEVEL=debug
