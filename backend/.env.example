# ==========================================
# Configuración del Servidor
# ==========================================
NODE_ENV=development
PORT=3001

# ==========================================
# Base de Datos (Supabase/PostgreSQL)
# ==========================================
# Obtén esto de Supabase > Settings > Database > Connection string (Transaction pooler)
DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[YOUR_PASSWORD]@aws-0-sa-east-1.pooler.supabase.com:6543/postgres"

# ==========================================
# JWT (Autenticación)
# ==========================================
JWT_SECRET=tu-clave-secreta-muy-larga-y-segura-de-al-menos-32-caracteres
JWT_EXPIRES_IN=7d

# ==========================================
# Encriptación
# ==========================================
ENCRYPTION_KEY=clave-de-32-caracteres-exactos!!

# ==========================================
# Wompi (Pagos Colombia)
# ==========================================
# Obtén estas llaves en https://comercios.wompi.co/
WOMPI_PUBLIC_KEY=pub_test_xxxxxxxxxxxxxxxx
WOMPI_PRIVATE_KEY=prv_test_xxxxxxxxxxxxxxxx
WOMPI_EVENT_SECRET=test_event_xxxxxxxxxxxxxxxx
WOMPI_INTEGRITY_SECRET=test_integrity_xxxxxxxxxxxxxxxx
WOMPI_ENVIRONMENT=test

# ==========================================
# URLs
# ==========================================
FRONTEND_URL=https://tu-frontend.vercel.app
BACKEND_URL=https://tu-backend.railway.app

# ==========================================
# OpenAI (Opcional - para asistentes)
# ==========================================
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxx
