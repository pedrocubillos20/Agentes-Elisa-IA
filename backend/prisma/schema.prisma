generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id              String         @id @default(cuid())
  email           String         @unique
  password        String
  name            String?
  phone           String?
  apiKey          String?
  apiKeyConnected Boolean        @default(false)
  
  // === TEAM / SUB-USERS ===
  role            String         @default("admin")
  parentUserId    String?
  permissions     Json           @default("{\"dashboard\":true,\"conversations\":true,\"crm\":true,\"agenda\":true,\"assistants\":true,\"whatsapp\":true,\"config\":true,\"team\":true,\"products\":true}")
  invitedBy       String?
  isActive        Boolean        @default(true)
  
  // === SUBSCRIPTION ===
  plan            String         @default("trial")
  trialEndsAt     DateTime?
  subscriptionId  String?
  
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  assistants      Assistant[]
  conversations   Conversation[]
  products        Product[]
  clients         Client[]
  appointments    Appointment[]
  subscription    Subscription?
  payments        Payment[]
  whatsappLines   WhatsappLine[]

  @@index([parentUserId])
  @@index([role])
}

// ===== MULTI-LÍNEA WHATSAPP =====
model WhatsappLine {
  id              String    @id @default(cuid())
  userId          String
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  label           String    @default("Principal")
  phone           String?
  sessionName     String    @unique
  status          String    @default("disconnected")
  
  assignedTo      String?
  assignedName    String?
  assistantId     String?
  
  isDefault       Boolean   @default(false)
  isActive        Boolean   @default(true)
  
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([userId])
  @@index([sessionName])
  @@index([status])
}

model Assistant {
  id              String    @id @default(cuid())
  userId          String
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  name            String
  context         String?   @db.Text
  personality     String?   @db.Text
  businessInfo    String?   @db.Text
  instructions    String?   @db.Text
  
  knowledgeItems  Json      @default("[]")
  mediaItems      Json      @default("[]")
  
  elevenLabsKey   String?
  selectedVoice   String?
  voiceEnabled    Boolean   @default(false)
  
  autoLearn       Boolean   @default(true)
  learningHistory Json      @default("[]")
  
  model           String    @default("gpt-4-turbo-preview")
  temperature     Float     @default(0.7)
  maxTokens       Int       @default(500)
  
  whatsappLineId  String?
  
  isActive        Boolean   @default(false)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([userId])
  @@index([whatsappLineId])
}

model Conversation {
  id            String    @id @default(cuid())
  recipientId   String
  recipientName String?
  lastMessage   String?
  aiPaused      Boolean   @default(false)
  stage         String    @default("new")
  assignedTo    String?
  assignedName  String?
  contextData   Json?
  whatsappLineId String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages      Message[]

  @@index([recipientId])
  @@index([userId, stage])
  @@index([assignedTo])
  @@index([whatsappLineId])
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  content        String       @db.Text
  fromMe         Boolean      @default(false)
  timestamp      DateTime     @default(now())
  mediaType      String?
  mediaUrl       String?      @db.Text
  userId         String?
  role           String       @default("user")
}

model Product {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  description String?  @db.Text
  price       Float
  category    String?
  image       String?  @db.Text
  stock       Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId])
}

model Client {
  id             String        @id @default(cuid())
  userId         String
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  name           String
  phone          String
  email          String?
  address        String?       @db.Text
  notes          String?       @db.Text
  tags           String[]      @default([])
  status         String        @default("lead")
  totalPurchases Float         @default(0)
  lastContact    DateTime?
  preferredLineId String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  appointments   Appointment[]

  @@index([userId])
}

model Appointment {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  clientId    String?
  client      Client?  @relation(fields: [clientId], references: [id], onDelete: SetNull)
  
  type        String
  clientName  String
  clientPhone String
  date        DateTime
  time        String
  duration    Int?
  status      String   @default("pending")
  notes       String?  @db.Text
  address     String?  @db.Text
  products    Json?
  total       Float?
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId, date])
}

model Subscription {
  id            String    @id @default(cuid())
  userId        String    @unique
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  plan          String
  period        String    @default("monthly")
  status        String    @default("active")
  
  priceUsd      Float
  priceCop      Float
  
  currentPeriodStart  DateTime
  currentPeriodEnd    DateTime
  cancelledAt         DateTime?
  
  wompiSubscriptionId String?
  wompiTransactionId  String?
  
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([status])
}

model Payment {
  id              String    @id @default(cuid())
  userId          String
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  type            String
  plan            String
  period          String
  
  amountUsd       Float
  amountCop       Float
  exchangeRate    Float
  cardSurcharge   Float    @default(0)
  totalCop        Float
  
  status          String   @default("pending")
  method          String?
  
  wompiTransactionId  String?   @unique
  wompiReference      String?
  wompiPaymentMethod  String?
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([userId])
  @@index([status])
  @@index([wompiTransactionId])
}
