# ============================================
# ELISA IA - Backend Environment Variables
# Evolution API v1.8.0 Compatible
# ============================================

# ===== Server =====
NODE_ENV=production
PORT=3000

# ===== Frontend URL =====
FRONTEND_URL=https://agentes-elisa-ia.vercel.app

# ===== Database (Supabase) =====
DATABASE_URL=postgresql://postgres.xxxxx:password@aws-1-sa-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true
DIRECT_URL=postgresql://postgres.xxxxx:password@aws-1-sa-east-1.pooler.supabase.com:5432/postgres

# ===== JWT =====
JWT_SECRET=tu-secreto-jwt-muy-seguro-2026

# ===== JWT Expiration =====
JWT_EXPIRES_IN=7d

# ===== Encryption Key =====
ENCRYPTION_KEY=tu-clave-de-encriptacion-32-chars

# ===== Evolution API v1.8.0 =====
EVOLUTION_API_URL=http://31.97.142.127:8080
EVOLUTION_API_KEY=ElisaIA_Evolution_Key_2026_SecretKey

# ===== Webhook =====
# Este es el endpoint donde Evolution API enviará los mensajes
WEBHOOK_URL=https://tu-backend.vercel.app/api/whatsapp/webhook

# ===== Wompi (Pagos - Opcional) =====
WOMPI_PUBLIC_KEY=pub_prod_xxxxx
WOMPI_PRIVATE_KEY=prv_prod_xxxxx
WOMPI_EVENT_SECRET=xxxxx
WOMPI_ENVIRONMENT=production
