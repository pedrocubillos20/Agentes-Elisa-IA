# ============================================
# ELISA IA - Variables de Entorno
# ============================================
# IMPORTANTE: Copiar este archivo como .env y completar los valores

# ============================================
# BASE DE DATOS - SUPABASE POSTGRESQL
# ============================================
# Obtén estas URLs desde: Supabase Dashboard > Settings > Database > Connection String

# URL para QUERIES (con pgbouncer, puerto 6543)
# Formato: postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true
DATABASE_URL="postgresql://postgres.xxxxxxxxxxxx:TU_PASSWORD@aws-0-us-west-1.pooler.supabase.com:6543/postgres?pgbouncer=true"

# URL para MIGRACIONES (conexión directa, puerto 5432)
# Formato: postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres
DIRECT_URL="postgresql://postgres.xxxxxxxxxxxx:TU_PASSWORD@aws-0-us-west-1.pooler.supabase.com:5432/postgres"

# ============================================
# SEGURIDAD
# ============================================
# Clave secreta para JWT (mínimo 32 caracteres, aleatorio)
# Generar con: openssl rand -base64 32
JWT_SECRET="ElisaIA_JWT_Secret_2026_CambiaEstoAhora_MuySeguro123!"

# Tiempo de expiración del token (ejemplo: 7d, 30d, 1h)
JWT_EXPIRES_IN="30d"

# Clave para encriptar las API Keys de OpenAI de los usuarios
# Generar con: openssl rand -base64 32
ENCRYPTION_KEY="ElisaIA_Encryption_Key_2026_ParaOpenAI_CambiaEsto!"

# ============================================
# EVOLUTION API (WhatsApp)
# ============================================
# URL de tu Evolution API (en VPS o servidor)
# Ejemplo: http://tu-ip-vps:8080 o https://evolution.tudominio.com
EVOLUTION_API_URL="http://TU_IP_VPS:8080"

# API Key configurada en Evolution API
EVOLUTION_API_KEY="TuApiKeyDeEvolution2026"

# ============================================
# URLs DE LA APLICACIÓN
# ============================================
# URL del frontend en Vercel
FRONTEND_URL="https://agentes-elisa-ia.vercel.app"

# URL del webhook (se genera automáticamente en Railway)
# Formato: https://tu-backend.up.railway.app/api/whatsapp/webhook
WEBHOOK_URL=""

# ============================================
# CONFIGURACIÓN DEL SERVIDOR
# ============================================
# Puerto (Railway lo asigna automáticamente vía $PORT)
PORT=3000

# Entorno
NODE_ENV="production"

# ============================================
# WOMPI (PAGOS - OPCIONAL)
# ============================================
WOMPI_PUBLIC_KEY=""
WOMPI_PRIVATE_KEY=""
WOMPI_EVENT_SECRET=""
WOMPI_ENVIRONMENT="sandbox"
